{
  "name": "dead_volume",
  "parameters": {
    "channel": {
      "type": "choice",
      "label": "Channel: 0 Oil-L / 1 M1 / 2 M2",
      "default": 1,
      "options": [
        0,
        1,
        2
      ]
    },
    "oil_name": {
      "type": "text",
      "label": "Liquid name",
      "default": "oil"
    }
  },
  "steps": [
    {
      "name": "Measurement 1",
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": 0
      },
      "on_complete": "hold",
      "confirm_message": "Measurement 1, channel {channel}: run the channel yourself, measure its dead volume and enter it in the measurements table, then confirm."
    },
    {
      "name": "Measurement 2",
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": 0
      },
      "on_complete": "hold",
      "confirm_message": "Measurement 2, channel {channel}: run the channel yourself, measure its dead volume and enter it in the measurements table, then confirm."
    },
    {
      "name": "Measurement 3",
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": 0
      },
      "on_complete": "hold",
      "confirm_message": "Measurement 3, channel {channel}: run the channel yourself, measure its dead volume and enter it in the measurements table, then confirm."
    }
  ],
  "measurements": {
    "dead_volume_1": {
      "label": "Measurement 1: dead volume",
      "unit": "uL",
      "min": 0,
      "step": 1,
      "required": true
    },
    "dead_volume_2": {
      "label": "Measurement 2: dead volume",
      "unit": "uL",
      "min": 0,
      "step": 2,
      "required": true
    },
    "dead_volume_3": {
      "label": "Measurement 3: dead volume",
      "unit": "uL",
      "min": 0,
      "step": 3,
      "required": true
    }
  },
  "calculations": [
    {
      "type": "dead_volume",
      "channel": "channel",
      "liquid": "{oil_name}",
      "volumes": [
        "dead_volume_1",
        "dead_volume_2",
        "dead_volume_3"
      ]
    }
  ]
}
