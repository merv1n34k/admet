{
  "name": "viscosity",
  "parameters": {
    "channel": {
      "type": "choice",
      "label": "Channel: 0 Oil-L / 1 M1 / 2 M2",
      "default": 1,
      "options": [
        0,
        1,
        2
      ]
    },
    "oil_name": {
      "type": "text",
      "label": "Liquid name",
      "default": "oil"
    },
    "low_flow": [
      "Lowest flow, µL/min",
      15
    ],
    "working_flow": [
      "Working flow, µL/min (M: 67; L: 250)",
      67
    ],
    "path_id": {
      "type": "text",
      "label": "Unchanged flow path ID",
      "default": "path-1"
    },
    "settle_s": [
      "Settling time, s",
      20
    ],
    "average_s": [
      "Averaging time, s",
      30
    ]
  },
  "steps": [
    {
      "name": "Pass 1 / level 1",
      "sensor_setpoints": {
        "{channel}": "low_flow"
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": "settle_s + average_s"
      },
      "timeout_s": "settle_s + average_s + 10",
      "on_complete": "zero",
      "confirm_message": "Channel {channel} only. Keep the filled bypass path, outlet height and path ID unchanged for both passes and the reference run. Confirm this pass. Select the matching gravimetry result or enter a recorded-flow multiplier before calculation. Compare reference liquids at comparable temperature."
    },
    {
      "name": "Pass 1 / level 2",
      "sensor_setpoints": {
        "{channel}": "(low_flow + working_flow) / 2"
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": "settle_s + average_s"
      },
      "timeout_s": "settle_s + average_s + 10",
      "on_complete": "zero"
    },
    {
      "name": "Pass 1 / level 3",
      "sensor_setpoints": {
        "{channel}": "working_flow"
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": "settle_s + average_s"
      },
      "timeout_s": "settle_s + average_s + 10",
      "on_complete": "zero"
    },
    {
      "name": "Pass 2 / level 3",
      "sensor_setpoints": {
        "{channel}": "working_flow"
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": "settle_s + average_s"
      },
      "timeout_s": "settle_s + average_s + 10",
      "on_complete": "zero",
      "confirm_message": "Channel {channel} only. Keep the filled bypass path, outlet height and path ID unchanged for both passes and the reference run. Confirm this pass. Select the matching gravimetry result or enter a recorded-flow multiplier before calculation. Compare reference liquids at comparable temperature."
    },
    {
      "name": "Pass 2 / level 2",
      "sensor_setpoints": {
        "{channel}": "(low_flow + working_flow) / 2"
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": "settle_s + average_s"
      },
      "timeout_s": "settle_s + average_s + 10",
      "on_complete": "zero"
    },
    {
      "name": "Pass 2 / level 1",
      "sensor_setpoints": {
        "{channel}": "low_flow"
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": "settle_s + average_s"
      },
      "timeout_s": "settle_s + average_s + 10",
      "on_complete": "zero"
    },
    {
      "name": "Finish recording",
      "sensor_setpoints": {
        "{channel}": 0
      },
      "trigger_type": "time",
      "trigger_params": {
        "duration_s": 1
      },
      "on_complete": "zero"
    }
  ],
  "measurements": {
    "flow_multiplier": {
      "label": "Recorded-flow multiplier (or select gravimetry result in Calculations)",
      "unit": "1",
      "min": 0
    },
    "known_viscosity": {
      "label": "Known viscosity (reference liquid only; otherwise leave blank)",
      "unit": "mPa.s",
      "min": 0
    }
  },
  "calculations": [
    {
      "type": "viscosity",
      "channel": "channel",
      "liquid": "{oil_name}",
      "path_id": "{path_id}",
      "flow_multiplier": "flow_multiplier",
      "known_viscosity": "known_viscosity",
      "samples": [
        {
          "step": 1,
          "pass": 1,
          "settle_s": "settle_s"
        },
        {
          "step": 2,
          "pass": 1,
          "settle_s": "settle_s"
        },
        {
          "step": 3,
          "pass": 1,
          "settle_s": "settle_s"
        },
        {
          "step": 4,
          "pass": 2,
          "settle_s": "settle_s"
        },
        {
          "step": 5,
          "pass": 2,
          "settle_s": "settle_s"
        },
        {
          "step": 6,
          "pass": 2,
          "settle_s": "settle_s"
        }
      ]
    },
    {
      "type": "recording_summary"
    }
  ]
}
